---
import { getEntry } from 'astro:content';
import ContactFigure from './ContactFigure.astro';

interface Props { status?: string | null }
const { status } = Astro.props;
const about = (await getEntry('about', 'about'))!;
// A paragraph written entirely in italics is the lead: it is set apart, with the figure beside it.
const html = about.rendered?.html ?? '';
const lead = html.match(/<p><em>([\s\S]*?)<\/em><\/p>/);
const before = lead ? html.slice(0, lead.index) : html;
const after = lead ? html.slice(lead.index! + lead[0].length) : '';
---
<section id="about" aria-label="About Zelong Xu" class="intro">
  <div class="prose" set:html={before} />
  {lead && (
    <div class="intro__band">
      <p class="intro__lead" set:html={lead[1]} />
      <ContactFigure />
    </div>
  )}
  {after.trim() && <div class="prose" set:html={after} />}
  {status && <p class="intro__status">{status}</p>}
</section>

<style>
  .intro__band { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px 36px; align-items: center; margin: 10px 0 8px; }
  .intro__lead { font-family: var(--serif); font-size: 20px; line-height: 1.4; font-style: italic; font-weight: 400; color: var(--strong); text-wrap: balance; }
  .intro__status {
    margin-top: 20px;
    padding: 9px 14px;
    background: #eef5f6;
    border-left: 3px solid var(--accent);
    border-radius: 0 4px 4px 0;
  }
  @media (max-width: 760px) {
    .intro__band { grid-template-columns: minmax(0, 1fr); margin: 14px 0 10px; }
  }
</style>
