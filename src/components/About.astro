---
import { getEntry, render } from 'astro:content';

interface Props { status?: string | null }
const { status } = Astro.props;
const about = (await getEntry('about', 'about'))!;
const { Content } = await render(about);
---
<section id="about" aria-label="About Zelong Xu" class="intro">
  <div class="prose"><Content /></div>
  {status && <p class="intro__status">{status}</p>}
</section>

<style>
  .intro__status { margin-top: 1rem; }
</style>
