---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import Section from './Section.astro';
import { formatMonth } from '../lib/format';

interface Props { profile: CollectionEntry<'profile'>['data'] }
const { profile } = Astro.props;
const about = (await getEntry('about', 'about'))!;
const { Content } = await render(about);
const news = (await getCollection('news')).sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<Section id="about" index="01" label="About" title="About me">
  <div class:list={['about', { 'about--photo': !!profile.photo }]}>
    {profile.photo && (
      <figure class="portrait" data-reveal>
        <Image src={profile.photo} alt={profile.name} width={480} densities={[1, 2]} format="webp" loading="lazy" />
      </figure>
    )}
    <div class="prose about__bio" data-reveal><Content /></div>
    {news.length > 0 && (
      <aside class="news" data-reveal style="--reveal-delay: 120ms" aria-labelledby="news-title">
        <h3 id="news-title" class="eyebrow news__title">News</h3>
        <ul>
          {news.map((item) => (
            <li>
              <time datetime={item.data.date}>{formatMonth(item.data.date)}</time>
              <span set:html={item.data.text}></span>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</Section>

<style>
  .about { display: grid; gap: 3rem; }
  .portrait { max-width: 15rem; margin: 0; }
  .portrait img {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
  }
  @media (min-width: 1000px) {
    .about { grid-template-columns: minmax(0, 1fr) 15rem; gap: 2.5rem 4.5rem; align-items: start; }
    .about--photo { grid-template-rows: auto 1fr; }
    .about--photo .about__bio { grid-column: 1; grid-row: 1 / 3; }
    .about--photo .portrait { grid-column: 2; grid-row: 1; }
    .about--photo .news { grid-column: 2; grid-row: 2; }
  }
  .news__title { margin-bottom: 0.5rem; }
  .news li {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .news li:last-child { border-bottom: 1px solid var(--rule); }
  .news time { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-3); }
</style>
