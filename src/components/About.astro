---
import { getEntry } from 'astro:content';
import ContactFigure from './ContactFigure.astro';

interface Props { status?: string | null }
const { status } = Astro.props;
const about = (await getEntry('about', 'about'))!;
// The first list in the introduction is the research interests: it is set apart, with the figure beside it.
const html = about.rendered?.html ?? '';
const list = html.match(/<ul>[\s\S]*?<\/ul>/);
const before = list ? html.slice(0, list.index) : html;
const after = list ? html.slice(list.index! + list[0].length) : '';
const interests = list ? [...list[0].matchAll(/<li>([\s\S]*?)<\/li>/g)].map((item) => item[1].trim()) : [];
---
<section id="about" aria-label="About Zelong Xu" class="intro">
  <div class="prose" set:html={before} />
  {list && (
    <div class="intro__band">
      <div>
        <p class="intro__label" id="interests-label">Research interests</p>
        <ul class="intro__interests" role="list" aria-labelledby="interests-label">
          {interests.map((interest) => <li set:html={interest} />)}
        </ul>
      </div>
      <ContactFigure />
    </div>
  )}
  {after.trim() && <div class="prose" set:html={after} />}
  {status && <p class="intro__status">{status}</p>}
</section>

<style>
  .intro__band { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px 36px; align-items: center; margin: 10px 0 8px; }
  .intro__label { margin-bottom: 6px; font-size: 13px; line-height: 1.4; font-weight: 500; color: var(--muted); }
  .intro__interests { margin: 0; padding: 0; list-style: none; font-family: var(--serif); font-size: 19px; line-height: 1.5; color: var(--strong); }
  .intro__status {
    margin-top: 20px;
    padding: 9px 14px;
    background: #eef5f6;
    border-left: 3px solid var(--accent);
    border-radius: 0 4px 4px 0;
  }
  @media (max-width: 760px) {
    .intro__band { grid-template-columns: minmax(0, 1fr); margin: 20px 0 10px; }
  }
</style>
