---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import XiaohongshuLogo from './XiaohongshuLogo.astro';

type Item = CollectionEntry<'profile'>['data']['beyond'][number];
interface Props { items: Item[] }

const items = await Promise.all(Astro.props.items.map(async (item) => ({
  ...item,
  photos: await Promise.all(item.photos.map(async (photo) => ({
    ...photo,
    // Thumbnails keep their aspect ratio (short side 200px); CSS crops them to a square.
    size: photo.image.width >= photo.image.height ? { height: 200 } : { width: 200 },
    full: await getImage({ src: photo.image, width: Math.min(1400, photo.image.width), format: 'webp', quality: 82 }),
  }))),
})));
---
{items.length > 0 && (
  <section id="beyond" class="beyond" aria-labelledby="beyond-title">
    <h2 class="section-title" id="beyond-title">Beyond Research</h2>
    <ul class="beyond__list" role="list">
      {items.map((item, i) => (
        <li class="beyond__item" data-slideshow data-delay={i * 1750}>
          <div>
            <a class="beyond__frame" href={item.photos[0].full.src} data-gallery
              aria-label={`${item.title} photos (${item.photos.length}), open viewer`}>
              {item.photos.map((photo, j) => (
                <Image class:list={['beyond__photo', { 'is-on': j === 0 }]} src={photo.image} alt={photo.alt}
                  {...photo.size} densities={[1, 2]} format="webp" quality={80}
                  loading="lazy" decoding="async" style={`object-position: ${photo.position}`}
                  data-full={photo.full.src} />
              ))}
            </a>
            {item.photos.length > 1 && (
              <div class="beyond__dots" role="group" aria-label={`Choose a ${item.title.toLowerCase()} photo`} hidden>
                {item.photos.map((photo, j) => (
                  <button type="button" aria-label={`Photo ${j + 1} of ${item.photos.length}: ${photo.alt}`}
                    aria-current={j === 0 ? 'true' : undefined}></button>
                ))}
              </div>
            )}
          </div>
          <div class="beyond__text">
            <p class="beyond__caption"><strong>{item.title}.</strong> {item.text}</p>
            {item.aside && (
              <a class="beyond__aside" href={item.aside.url}>
                <span class="beyond__aside-label">{item.aside.label}</span>
                {item.aside.logo === 'xiaohongshu'
                  ? <XiaohongshuLogo label={item.aside.platform} class="beyond__aside-logo" />
                  : <span class="beyond__aside-platform">{item.aside.platform}</span>}
                {item.aside.detail && <span class="beyond__aside-detail">{item.aside.detail}</span>}
                <Icon name="arrow" class="beyond__aside-icon" />
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>

    <dialog class="lightbox" aria-label="Photo viewer">
      <figure class="lightbox__figure">
        <img class="lightbox__img" alt="" />
        <figcaption class="lightbox__bar">
          <button type="button" class="lightbox__prev" data-step="-1" aria-label="Previous photo"><Icon name="chevron" /></button>
          <span class="lightbox__caption" aria-live="polite"></span>
          <button type="button" class="lightbox__next" data-step="1" aria-label="Next photo"><Icon name="chevron" /></button>
          <button type="button" data-close>Close</button>
        </figcaption>
      </figure>
    </dialog>
  </section>
)}

<style>
  .beyond { margin-top: 48px; }
  .beyond__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 28px; }
  .beyond__item { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 0 28px; align-items: start; }

  .beyond__frame {
    position: relative;
    display: block;
    width: 200px;
    aspect-ratio: 1;
    margin-top: 4px;
    overflow: hidden;
    border-radius: 4px;
    background: var(--rule);
    cursor: zoom-in;
  }
  .beyond__frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 900ms ease, transform 4s ease-out;
  }
  .beyond__frame :global(img.is-on) { opacity: 1; transform: none; }

  .beyond__dots { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 9px; }
  .beyond__dots[hidden] { display: none; }
  .beyond__dots button {
    position: relative;
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #d5dadb;
    transition: background-color 200ms ease, transform 200ms ease;
  }
  .beyond__dots button::after { content: ''; position: absolute; inset: -5px; }
  .beyond__dots button[aria-current='true'] { background: var(--accent); transform: scale(1.3); }

  .beyond__caption { font-size: 15px; line-height: 1.6; }
  .beyond__caption strong { font-weight: 600; }

  .beyond__aside { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; margin-top: 12px; text-decoration: none; }
  .beyond__aside::before { content: ''; align-self: center; width: 18px; height: 1px; background: var(--accent); }
  .beyond__aside-label { font-family: var(--serif); font-style: italic; font-size: 17px; color: var(--ink); text-decoration: underline transparent; text-underline-offset: 0.2em; transition: text-decoration-color 120ms ease; }
  .beyond__aside-platform { font-family: var(--serif); font-weight: 600; color: var(--accent); }
  .beyond__aside :global(.beyond__aside-logo) { align-self: center; height: 21px; width: auto; border-radius: 4px; transition: transform 200ms ease; }
  .beyond__aside:hover :global(.beyond__aside-logo) { transform: rotate(-3deg) scale(1.04); }
  .beyond__aside-detail { font-size: 11.5px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .beyond__aside :global(.beyond__aside-icon) { align-self: center; width: 14px; height: 14px; color: var(--accent); transition: transform 200ms ease; }
  .beyond__aside:hover .beyond__aside-label { text-decoration-color: var(--accent); }
  .beyond__aside:hover :global(.beyond__aside-icon) { transform: translate(2px, -2px); }

  .lightbox { max-width: min(92vw, 1000px); max-height: 94vh; padding: 0; border: 0; background: transparent; overflow: visible; }
  .lightbox::backdrop { background: rgb(16 24 27 / 0.86); }
  .lightbox__figure { display: grid; gap: 12px; justify-items: center; margin: 0; }
  .lightbox__img { width: auto; height: auto; max-width: min(92vw, 1000px); max-height: 80vh; border-radius: 4px; }
  .lightbox[open] .lightbox__img { animation: lightbox-in 220ms ease-out; }
  @keyframes lightbox-in { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: none; } }
  .lightbox__bar { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px 10px; color: #fff; font-size: 14px; text-align: center; }
  .lightbox__bar button { display: inline-grid; place-items: center; min-width: 36px; height: 36px; padding: 0 12px; color: #fff; background: rgb(255 255 255 / 0.12); border: 0; border-radius: 4px; }
  .lightbox__bar button:hover { background: rgb(255 255 255 / 0.24); }
  .lightbox__bar button[hidden] { display: none; }
  .lightbox__prev :global(svg) { transform: rotate(90deg); }
  .lightbox__next :global(svg) { transform: rotate(-90deg); }

  @media (max-width: 760px) {
    .beyond__item { grid-template-columns: 120px minmax(0, 1fr); gap: 0 16px; }
    .beyond__frame { width: 120px; margin-top: 2px; }
    .beyond__dots { gap: 5px; }
    .beyond__dots button { width: 5px; height: 5px; }
    .beyond__caption { font-size: 14px; }
    .beyond__aside-label { font-size: 16px; }
    .beyond__aside :global(.beyond__aside-logo) { height: 19px; }
  }
  @media print { .beyond { display: none; } }
</style>
