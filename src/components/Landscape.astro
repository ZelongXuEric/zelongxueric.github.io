---
// Decorative figure for the hero; the animation lives in ../scripts/landscape.ts.
---
<figure class="fig">
  <div class="fig__frame">
    <canvas data-landscape aria-hidden="true"></canvas>
  </div>
  <figcaption class="fig__caption">
    <span class="fig__num">Fig. 1</span>Gradient descent on a drifting loss landscape.
  </figcaption>
</figure>

<script>
  import '../scripts/landscape';
</script>

<style>
  .fig { margin: 0; }
  .fig__frame {
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background-color: var(--bg-elev);
    background-image: radial-gradient(var(--rule) 1px, transparent 1px);
    background-size: 18px 18px;
    background-position: center;
  }
  canvas {
    width: 100%;
    aspect-ratio: 4 / 3;
    /* Read by the script as the contour (color) and trajectory (border) colours. */
    color: var(--ink);
    border: 0 solid var(--accent);
    touch-action: pan-y;
  }
  .fig__caption {
    margin-top: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .fig__num { margin-right: 0.6rem; color: var(--accent); font-weight: 500; }
</style>
