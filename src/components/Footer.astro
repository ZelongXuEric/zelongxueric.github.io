---
interface Props { repo?: string | null }
const { repo } = Astro.props;
---
{repo && <footer class="site-footer"><a href={repo}>Source</a></footer>}

<style>
  .site-footer { margin-top: 42px; padding-top: 14px; border-top: 1px solid var(--rule); font-size: 12px; }
  a { color: var(--muted); text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
