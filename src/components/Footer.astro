---
// Build date; every deploy rebuilds the site, so this tracks the last published change.
const updated = new Date().toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<footer class="site-footer"><p>Last updated {updated}</p></footer>

<style>
  .site-footer { margin-top: 42px; padding-top: 14px; border-top: 1px solid var(--rule); font-size: 12px; color: var(--muted); }
</style>
