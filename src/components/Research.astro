---
import Section from './Section.astro';

interface Props { interests: { title: string; blurb: string }[] }
const { interests } = Astro.props;
---
<Section id="research" index="02" label="Research" title="Research interests">
  <ol class="research">
    {interests.map((item, i) => (
      <li class="research__item" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
        <span class="research__num" aria-hidden="true">0{i + 1}</span>
        <div>
          <h3 class="research__title">{item.title}</h3>
          <p class="research__blurb">{item.blurb}</p>
        </div>
      </li>
    ))}
  </ol>
</Section>

<style>
  .research__item {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule);
  }
  .research__item:last-child { border-bottom: 1px solid var(--rule); }
  .research__num {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-style: italic;
    line-height: 1.2;
    color: var(--ink-3);
    transition: color 0.25s;
  }
  .research__item:hover .research__num { color: var(--accent); }
  .research__title { font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.7rem); }
  .research__blurb { max-width: 62ch; margin-top: 0.6rem; color: var(--ink-2); text-wrap: pretty; }
</style>
