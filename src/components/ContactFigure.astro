---
// The intro figure, without words: a ribbon diagram of one small protein in ink and a wash of
// color, drawn along its chain. The residue contacts a protein language model proposes for it
// are then tested against the crystal structure. The data comes from scripts/contact-figure.py.
// The figure needs JavaScript to draw, so it stays hidden without it.
import data from '../data/contact-figure.json';

const confirmed = data.contacts.filter(([, , ok]) => ok).length;
const about = `Ribbon diagram of protein GB1 (PDB ${data.pdb}). Of the ${data.contacts.length} residue contacts the protein language model ESM-2 predicts for it, the crystal structure confirms ${confirmed}.`;
---
<figure class="contacts" hidden>
  <canvas role="img" aria-label={about} title={`${about} Click to replay.`}></canvas>
</figure>

<style>
  .contacts { margin: 0; }
  .contacts[hidden] { display: none; }
  canvas { display: block; width: 212px; height: 152px; cursor: pointer; }
</style>

<script>
  import data from '../data/contact-figure.json';
  import { duration, fit, model, REACH, scene, viewAt, type FigureData, type Frame, type Shape } from '../lib/contactFigure';

  const PAPER = '#fff';

  /** Paints the shapes, which arrive sorted from the back of the molecule to the front. */
  function paint(context: CanvasRenderingContext2D, shapes: Shape[], frame: Frame) {
    context.clearRect(0, 0, frame.width, frame.height);
    context.lineJoin = 'round';
    for (const shape of shapes) {
      context.setLineDash([]);
      context.globalAlpha = 1;
      context.beginPath();
      if (shape.kind === 'band') {
        const [a, b, c, d] = shape.corners;
        context.moveTo(a.x, a.y); context.lineTo(b.x, b.y); context.lineTo(c.x, c.y); context.lineTo(d.x, d.y);
        context.closePath();
        // The fill is stroked in its own color too, which hides the seams between neighboring pieces.
        context.fillStyle = context.strokeStyle = shape.fill;
        context.lineWidth = 0.7;
        context.fill();
        context.stroke();
        context.beginPath();
        context.moveTo(a.x, a.y); context.lineTo(d.x, d.y);
        context.moveTo(b.x, b.y); context.lineTo(c.x, c.y);
        context.strokeStyle = shape.edge;
        context.lineWidth = shape.width;
        context.lineCap = 'round';
        context.stroke();
      } else if (shape.kind === 'dot') {
        context.globalAlpha = shape.alpha;
        context.fillStyle = shape.color;
        context.arc(shape.x, shape.y, shape.r, 0, 2 * Math.PI);
        context.fill();
      } else {
        context.moveTo(shape.from.x, shape.from.y);
        context.lineTo(shape.to.x, shape.to.y);
        if (shape.kind === 'loop') {
          context.strokeStyle = PAPER;
          context.lineWidth = shape.width + 2.4;
          context.lineCap = 'butt';
          context.stroke();
        } else {
          context.globalAlpha = shape.alpha;
          if (shape.dash) context.setLineDash([...shape.dash]);
        }
        context.strokeStyle = shape.color;
        context.lineWidth = shape.width;
        context.lineCap = shape.kind === 'stitch' && shape.dash ? 'butt' : 'round';
        context.stroke();
      }
    }
    context.globalAlpha = 1;
  }

  function start(figure: HTMLElement, canvas: HTMLCanvasElement) {
    const context = canvas.getContext('2d');
    if (!context) return;
    figure.hidden = false;

    const ribbon = model(data as unknown as FigureData);
    const count = ribbon.contacts.length;
    const total = duration(count);
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let ms = still ? total : 0; // time since the sequence began; it keeps running for the sway
    let visible = false;
    let started = false;
    const turn = { yaw: 0, pitch: 0 }; // what the pointer adds to the view
    let aim = { yaw: 0, pitch: 0 };
    let frame: Frame = { width: 0, height: 0, scale: 1 };
    let pending = 0;
    let last = 0;
    let drawnAt = 0;

    function resize() {
      const { width, height } = canvas.getBoundingClientRect();
      const ratio = window.devicePixelRatio || 1;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context!.setTransform(ratio, 0, 0, ratio, 0, 0);
      frame = { width, height, scale: fit(ribbon, width, height) };
    }

    function draw() {
      const view = viewAt(ms, count, still);
      paint(context!, scene(ribbon, { yaw: view.yaw + turn.yaw, pitch: view.pitch + turn.pitch }, frame, ms), frame);
    }

    function tick(now: number) {
      pending = 0;
      const elapsed = Math.min(50, now - last); // a hidden tab pauses the figure instead of skipping ahead
      last = now;
      if (started) ms += elapsed;
      const ease = 1 - Math.exp(-elapsed / 140);
      turn.yaw += (aim.yaw - turn.yaw) * ease;
      turn.pitch += (aim.pitch - turn.pitch) * ease;
      const turning = Math.abs(aim.yaw - turn.yaw) + Math.abs(aim.pitch - turn.pitch) > 0.002;
      // The slow sway does not need every frame; the sequence and the pointer do.
      if (ms < total || turning || now - drawnAt > 30) {
        draw();
        drawnAt = now;
      }
      if (visible && started) request();
    }

    function request() {
      pending ||= requestAnimationFrame(tick);
    }

    function play() {
      ms = 0;
      started = true;
      request();
    }

    resize();
    draw();
    window.addEventListener('resize', () => { resize(); draw(); });
    if (still) return;

    // The sequence plays once when the figure comes into view, and a click replays it.
    // Off screen the figure stops drawing.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (!visible) return;
      if (started) request();
      else setTimeout(play, 300);
    }, { threshold: 0.35 }).observe(canvas);
    canvas.addEventListener('click', play);

    // The molecule turns a little toward the pointer and returns when it leaves.
    canvas.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') return;
      const box = canvas.getBoundingClientRect();
      aim = {
        yaw: (((event.clientX - box.left) / box.width) * 2 - 1) * REACH.yaw,
        pitch: (((event.clientY - box.top) / box.height) * 2 - 1) * REACH.pitch,
      };
      request();
    });
    canvas.addEventListener('pointerleave', () => { aim = { yaw: 0, pitch: 0 }; request(); });
  }

  for (const figure of document.querySelectorAll<HTMLElement>('.contacts')) {
    const canvas = figure.querySelector('canvas');
    if (canvas) start(figure, canvas);
  }
</script>
