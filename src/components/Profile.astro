---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import XiaohongshuIcon from './XiaohongshuIcon.astro';
import { withBase } from '../lib/url';

interface Props { profile: CollectionEntry<'profile'>['data'] }
const { profile } = Astro.props;
const links = profile.links.filter((link) => link.url);
---
<header class="profile">
  {profile.photo && (
    <Image class="profile__photo" src={profile.photo} alt={`Portrait of ${profile.name}`}
      width={160} densities={[1, 2]}
      loading="eager" fetchpriority="high" format="webp" />
  )}
  <div class="profile__identity">
    <h1>
      <span class="profile__name">{profile.name}</span>
      {profile.nameZh && <span class="profile__name-zh" lang="zh-CN">{profile.nameZh}</span>}
    </h1>
    <p class="profile__role">{profile.role}</p>
    <p class="profile__affiliation">
      {profile.affiliationLogo && (
        <img class="profile__crest" src={profile.affiliationLogo.src} alt="" aria-hidden="true"
          width={profile.affiliationLogo.width} height={profile.affiliationLogo.height} />
      )}
      <span>{profile.affiliationShort ?? profile.affiliation}</span>
    </p>
  </div>
  <nav class="profile__links" aria-label="Contact and profiles">
    {profile.location && (
      <span class="profile__location"><Icon name="pin" /><span>{profile.location}</span></span>
    )}
    {links.map((link) => (
      <a href={link.url!.startsWith('/') ? withBase(link.url!) : link.url!}>
        {link.icon === 'xiaohongshu' ? <XiaohongshuIcon /> : <Icon name={link.icon} />}<span>{link.label}</span>
      </a>
    ))}
  </nav>
</header>

<style>
  .profile { min-width: 0; }
  .profile__photo { width: 152px; height: 152px; border-radius: 50%; object-fit: cover; margin-bottom: 21px; }
  h1 { margin-bottom: 9px; }
  .profile__name { display: block; font-family: var(--serif); font-size: 29px; font-weight: 600; line-height: 1.2; }
  .profile__name-zh { display: block; margin-top: 5px; font-family: var(--serif-zh); font-size: 16px; font-weight: 500; line-height: 1.4; letter-spacing: 0.14em; color: var(--muted); }
  .profile__role, .profile__affiliation { font-size: 14px; color: var(--muted); line-height: 1.6; }
  .profile__affiliation { display: flex; align-items: center; gap: 7px; margin-top: 3px; }
  .profile__crest { width: auto; height: 20px; flex: 0 0 auto; }
  .profile__links { display: flex; flex-direction: column; align-items: flex-start; gap: 5px; margin-top: 19px; }
  .profile__links a, .profile__location { display: inline-flex; align-items: center; gap: 9px; min-height: 28px; font-size: 14px; color: var(--muted); text-decoration: none; }
  .profile__links a:hover { color: var(--accent); text-decoration: underline; }
  .profile__links :global(svg) { width: 14px; height: 14px; flex: 0 0 auto; }
  @media (min-width: 761px) and (min-height: 620px) {
    .profile { position: sticky; top: 48px; }
  }
  @media (max-width: 760px) {
    .profile { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 0 22px; align-items: center; }
    .profile__photo { width: 104px; height: 104px; margin: 0; grid-row: 1; }
    .profile__identity { grid-column: 2; }
    .profile__links { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; gap: 4px 24px; margin-top: 15px; }
    .profile__links a, .profile__location { min-height: 36px; }
    .profile__name { font-size: 27px; }
  }
  @media (max-width: 360px) {
    .profile { grid-template-columns: 84px minmax(0, 1fr); gap: 0 16px; }
    .profile__photo { width: 84px; height: 84px; }
  }
  @media print { .profile { position: static; } }
</style>
