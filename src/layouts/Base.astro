---
import '../styles/global.css';
import plexUrl from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import serifUrl from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import { getEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props { title?: string; description?: string }

const profile = (await getEntry('profile', 'profile'))!.data;
const {
  title = `${profile.name} — ${profile.role}, ${profile.affiliation}`,
  description = profile.description,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('og.png'), Astro.site);
const sameAs = profile.links.map((link) => link.url).filter((url): url is string => !!url && /^https?:/.test(url));
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  ...(profile.nameZh ? { alternateName: profile.nameZh } : {}),
  email: `mailto:${profile.email}`,
  jobTitle: profile.role,
  url: Astro.site?.href,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: profile.affiliation,
    ...(profile.affiliationUrl ? { url: profile.affiliationUrl } : {}),
  },
  ...(sameAs.length ? { sameAs } : {}),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={plexUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
