---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Profile from '../components/Profile.astro';
import About from '../components/About.astro';
import Publications from '../components/Publications.astro';
import Beyond from '../components/Beyond.astro';
import Footer from '../components/Footer.astro';

const profile = (await getEntry('profile', 'profile'))!.data;
---
<Base>
  <div class="site-shell">
    <Profile profile={profile} />
    <main id="main" tabindex="-1">
      <About status={profile.status} />
      <Publications me={profile.name} />
      <Beyond items={profile.beyond} />
      <Footer />
    </main>
  </div>
</Base>
