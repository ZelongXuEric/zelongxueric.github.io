---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
---
<Base title="Page not found">
  <main id="main" class="notfound" tabindex="-1">
    <p>404</p>
    <h1>This page does not exist.</h1>
    <p><a href={withBase('/')}>Back to the homepage</a></p>
  </main>
</Base>

<style>
  .notfound { display: grid; align-content: center; gap: 1rem; min-height: 60svh; width: min(620px, calc(100% - 40px)); margin: 0 auto; }
  h1 { font-size: 28px; }
</style>
